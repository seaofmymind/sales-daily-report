# Database (Prisma)
# 로컬: postgresql://USER:PASSWORD@localhost:5432/sales_report
# Cloud Run: postgresql://USER:PASSWORD@localhost/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://postgres:password@localhost:5432/sales_report

# JWT
JWT_SECRET=your-access-token-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars
JWT_EXPIRES_IN=3600
